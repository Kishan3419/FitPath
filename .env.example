# Set a domain with an A record pointing at your OCI public IPv4 address.
FITPATH_DOMAIN=fitness.example.com

# PostgreSQL database reachable from the FitPath container.
PGHOST=postgres.example.com
PGPORT=5432
PGDATABASE=fitpath
PGUSER=fitpath
PGPASSWORD=replace-with-a-database-password

# Optional sign-in and coaching. Keep API keys in this server-side file only.
GOOGLE_CLIENT_ID=193699169513-2p6sroso08aoadvq7pkoq56vlj00cs62.apps.googleusercontent.com
GEMINI_API_KEY=

# Replace with an email address monitored by the service operator before launch.
FITPATH_CONTACT_EMAIL=
